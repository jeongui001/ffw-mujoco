<!-- 로봇이 작업대 위의 두 캔을 잡는 장면이다. model은 장면을 식별하는 이름이다. -->
<!-- 길이는 m, 질량은 kg이다. pos는 부모 좌표계의 x y z, rgba는 빨강 초록 파랑 불투명도 순서다. -->
<mujoco model="FFW-SH5 can manipulation">
  <!-- 로봇의 몸체, 관절, 손, 구동기와 기본 물리 설정을 기존 모델에서 가져온다. -->
  <include file="../robotis_ffw/ffw_sh5.xml"/>
  <!-- 이 장면 파일을 기준으로 로봇 메시 파일을 찾을 디렉터리를 지정한다. -->
  <compiler meshdir="../robotis_ffw/assets"/>

  <!-- 뷰어에서 장면을 어떻게 보여 줄지 설정한다. -->
  <visual>
    <!-- 카메라 조명의 확산광은 RGB 각 0.6, 주변광은 각 0.3으로 하고 반사 하이라이트는 끈다. -->
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
  </visual> <!-- 화면 표시 설정 끝. -->
  <!-- 아래 형상들이 이름으로 참조할 텍스처와 재질을 등록한다. -->
  <asset>
    <!-- ground라는 2차원 체크무늬를 만든다. rgb1과 rgb2는 번갈아 나타나는 두 색이다. -->
    <!-- width와 height는 생성할 텍스처 이미지의 가로와 세로 픽셀 수다. -->
    <texture type="2d" name="ground" builtin="checker" rgb1="0.25 0.28 0.32"
             rgb2="0.4 0.43 0.47" width="256" height="256"/>
    <!-- ground 텍스처를 쓰는 동명의 재질이다. 반복 수는 5 5이며 실제 형상 크기에 맞춰 무늬를 적용한다. -->
    <material name="ground" texture="ground" texrepeat="5 5" texuniform="true"/>
  </asset> <!-- 텍스처와 재질 등록 끝. -->

  <!-- class로 재사용할 공통 속성을 정의한다. 개별 geom에서 같은 속성을 지정하면 그 값이 우선한다. -->
  <default>
    <!-- 캔의 뚜껑과 띠처럼 외형만 꾸미는 형상에 적용할 기본값이다. -->
    <default class="can_visual">
      <!-- 원기둥 장식이다. 두 충돌 비트마스크를 0으로 하여 접촉 계산에서 제외한다. -->
      <!-- mass=0은 질량에 기여하지 않게 하고, group=2는 뷰어에서 표시를 관리할 그룹을 지정한다. -->
      <geom type="cylinder" contype="0" conaffinity="0" mass="0" group="2"/>
    </default> <!-- 캔 장식 기본값 끝. -->
    <!-- 손이나 작업대와 실제로 충돌하는 캔 몸통에 적용할 기본값이다. -->
    <default class="can_collision">
      <!-- cylinder의 size는 반지름과 반높이다. 지름 6.4cm, 전체 높이 12cm, 질량 120g이다. -->
      <!-- condim=6은 법선 접촉과 접선 마찰 외에 접촉면 비틀림 및 구름 마찰도 계산한다. -->
      <!-- friction은 미끄럼, 비틀림, 구름 마찰 순서로 접촉 시 미끄러지거나 회전하는 저항을 정한다. -->
      <!-- solref는 접촉 보정의 시간상수 0.01초와 감쇠비 1을 지정한다. -->
      <!-- solimp는 접촉 제약의 임피던스 하한 0.95, 상한 0.99, 변화 폭 0.001m를 지정한다. -->
      <geom type="cylinder" size="0.032 0.06" mass="0.12" condim="6"
            friction="1.2 0.008 0.0002" solref="0.01 1" solimp="0.95 0.99 0.001"/>
    </default> <!-- 캔 충돌 기본값 끝. -->
  </default> <!-- 공통 속성 정의 끝. -->

  <!-- 월드 좌표계에 조명, 바닥, 작업대, 캔을 배치한다. -->
  <worldbody>
    <!-- 높이 2.5m에 조명을 두고 아래쪽을 비춘다. directional=true이므로 평행한 빛을 사용한다. -->
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <!-- 위치와 회전의 기본값으로 z=0에 수평 바닥을 만든다. ground 재질의 체크무늬를 표시한다. -->
    <!-- plane은 물리적으로 무한한 평면이다. size의 값은 평면을 화면에 표시하는 데 사용한다. -->
    <geom name="floor" type="plane" size="0 0 0.05" material="ground"/>
    <!-- 작업대 중심을 월드 좌표 (0.9, 0, 0.4)m에 둔다. 관절이 없어 월드에 고정된다. -->
    <!-- 한 변 0.8m는 로봇 기준 높이 1.6m의 절반이며, 리프트 위치와 무관하게 유지된다. -->
    <body name="workbench" pos="0.9 0 0.4">
      <!-- box의 size는 각 축의 반길이다. 실제 크기는 0.8 x 0.8 x 0.8m이고 윗면은 z=0.8m다. -->
      <!-- rgba는 불투명한 회색, friction은 미끄럼 0.8, 비틀림 0.005, 구름 0.0001이다. -->
      <geom name="workbench_top" type="box" size="0.4 0.4 0.4"
            rgba="0.30 0.33 0.38 1" friction="0.8 0.005 0.0001"/>
    </body> <!-- 고정 작업대 정의 끝. -->
    <!-- 오른손 쪽 캔의 초기 중심이다. 충돌 형상 바닥은 z=0.801m로 작업대보다 1mm 높다. -->
    <body name="can_right" pos="0.56 -0.22 0.861">
      <!-- 이동 3축과 회전 3축을 자유롭게 하여 중력과 접촉력으로 움직이게 한다. -->
      <freejoint name="can_right_free"/>
      <!-- 공통 충돌 설정을 가져온 빨간 몸통이다. 이 형상이 캔의 질량과 실제 접촉을 담당한다. -->
      <geom name="can_right_collision" class="can_collision" rgba="0.82 0.12 0.10 1"/>
      <!-- 캔 중심보다 5.95cm 위에 반지름 3.25cm, 전체 두께 2mm인 은색 윗뚜껑을 그린다. -->
      <geom class="can_visual" pos="0 0 0.0595" size="0.0325 0.001" rgba="0.8 0.82 0.85 1"/>
      <!-- 같은 은색 장식을 중심보다 5.95cm 아래에 배치해 밑뚜껑을 표현한다. -->
      <geom class="can_visual" pos="0 0 -0.0595" size="0.0325 0.001" rgba="0.8 0.82 0.85 1"/>
      <!-- pos를 생략하여 캔 중심에 흰색 띠를 둔다. 반지름 3.21cm, 전체 높이 1.8cm다. -->
      <geom class="can_visual" size="0.0321 0.009" rgba="0.95 0.95 0.94 1"/>
    </body> <!-- 오른쪽 캔 정의 끝. 내부 장식의 위치는 캔 기준이므로 캔과 함께 움직인다. -->
    <!-- 왼손 쪽 캔이다. 오른쪽 캔과 x, z는 같고 y 부호를 바꿔 대칭으로 배치한다. -->
    <body name="can_left" pos="0.56 0.22 0.861">
      <!-- 왼쪽 캔도 이동과 회전이 자유롭다. 손에 고정하는 연결은 추가하지 않는다. -->
      <freejoint name="can_left_free"/>
      <!-- 오른쪽과 같은 크기, 질량, 접촉 설정을 쓰되 몸통 색은 파란색으로 구분한다. -->
      <geom name="can_left_collision" class="can_collision" rgba="0.10 0.30 0.85 1"/>
      <!-- 캔 중심보다 5.95cm 위의 은색 윗뚜껑이다. can_visual이므로 충돌과 질량에 기여하지 않는다. -->
      <geom class="can_visual" pos="0 0 0.0595" size="0.0325 0.001" rgba="0.8 0.82 0.85 1"/>
      <!-- 캔 중심보다 5.95cm 아래의 은색 밑뚜껑이다. 크기는 윗뚜껑과 같다. -->
      <geom class="can_visual" pos="0 0 -0.0595" size="0.0325 0.001" rgba="0.8 0.82 0.85 1"/>
      <!-- 캔 중심에 오른쪽 캔과 같은 크기의 흰색 띠를 그린다. -->
      <geom class="can_visual" size="0.0321 0.009" rgba="0.95 0.95 0.94 1"/>
    </body> <!-- 왼쪽 캔 정의 끝. -->
  </worldbody> <!-- 월드에 배치할 물체와 조명 정의 끝. -->
</mujoco> <!-- 장면 정의 끝. 실제 파지 동작의 순서는 simulation/grasp.py에서 제어한다. -->
